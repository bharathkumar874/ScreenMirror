<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <EditText
        android:id="@+id/editTxtIpAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter IP Address"
        android:inputType="text"
        android:text="192.168.1.16" />

    <EditText
        android:id="@+id/editTxtPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Port"
        android:inputType="number"
        android:text="8765"
        android:layout_marginTop="8dp" />
    
    <Button
        android:id="@+id/btnStartCapture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Screen Mirroring"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnStopCapture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Screen Mirroring"
        android:enabled="false"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:text="Status: Ready to start screen sharing"
        android:textSize="16sp"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:background="#f0f0f0"
        android:text="Note:\nTo get the IP address of your network:\n- On Mac: In Terminal, run 'ipconfig getifaddr en0'\n- On Windows: In Command Prompt, run 'ipconfig' and find the IPv4 address for your active adapter."
        android:textSize="12sp" />
</LinearLayout>
