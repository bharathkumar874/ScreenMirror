<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/header_gradient"
        android:padding="24dp"
        android:gravity="center_vertical">

        <!-- Icon -->
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:text="📺"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_marginEnd="16dp" />

        <!-- Title and Subtitle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ScreenMirror"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cast your screen wirelessly"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:alpha="0.9" />

        </LinearLayout>

    </LinearLayout>

    <!-- Content Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Connection Status Section (Integrated with Status Text) -->

            <!-- Network Settings Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Network Settings Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📶"
                            android:textSize="20sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Network Settings"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                    </LinearLayout>

                    <!-- IP Address Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F8F9FA">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IP Address"
                                android:textSize="14sp"
                                android:textColor="#666666"
                                android:layout_marginBottom="8dp" />

                            <EditText
                                android:id="@+id/editTxtIpAddress"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@android:color/transparent"
                                android:text="192.168.1.13"
                                android:textSize="16sp"
                                android:textColor="#333333"
                                android:inputType="text"
                                android:padding="0dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Port Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F8F9FA">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Port"
                                android:textSize="14sp"
                                android:textColor="#666666"
                                android:layout_marginBottom="8dp" />

                            <EditText
                                android:id="@+id/editTxtPort"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@android:color/transparent"
                                android:text="8765"
                                android:textSize="16sp"
                                android:textColor="#333333"
                                android:inputType="number"
                                android:padding="0dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>
    
            <!-- Start Button -->
            <Button
                android:id="@+id/btnStartCapture"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="▶ Start Screen Mirroring"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="#2196F3"
                android:layout_marginBottom="16dp" />

            <!-- Stop Button (Initially Hidden) -->
            <Button
                android:id="@+id/btnStopCapture"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="✕ Stop Screen Mirroring"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="#E57373"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- Status Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F8F9FA">

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Status: ● Inactive - Ready to start screen sharing"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:gravity="center" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:padding="8dp"
                android:background="#f0f0f0"
                android:text="Note:\nTo get the IP address of your network:\n- On Mac: In Terminal, run 'ipconfig getifaddr en0'\n- On Windows: In Command Prompt, run 'ipconfig' and find the IPv4 address for your active adapter."
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
